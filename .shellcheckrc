# shellcheck policy for every *.sh in this repository. shellcheck finds this
# file by walking up from the checked script's directory, so a bare
# `shellcheck <file>` picks it up from any working directory.
#
# Follow `source` statements into files not named on the command line.
external-sources=true
# Resolve sourced paths, including `# shellcheck source=../lib.sh` directives,
# against the checked script's own directory rather than the working directory.
source-path=SCRIPTDIR
#
# No `disable=` here: silence a genuinely wrong finding on its own line, with a
# reason beside it (AGENTS.md §Linting). tests/test-shellcheck.sh rejects one.
# No `shell=` either: every tracked *.sh carries a bash shebang, and a
# repo-wide `shell=bash` would lint a future #!/bin/sh script as bash.
