# shellcheck policy for every *.sh in this repository. shellcheck finds this
# file by walking up from the checked script's directory, so a bare
# `shellcheck <file>` picks it up from any working directory.
#
# Follow `source` statements into files not named on the command line.
external-sources=true
# Resolve sourced paths, including `# shellcheck source=../lib.sh` directives,
# against the checked script's own directory rather than the working directory.
source-path=SCRIPTDIR
#
# These two keys, one per line with an unquoted value, and comments are all
# this file holds: tests/test-shellcheck.sh fails on any other line, which
# would apply to every script. Silence a genuinely wrong finding on its own
# line, with a reason beside it (AGENTS.md §Linting). Every tracked *.sh
# carries a bash shebang, which is how shellcheck knows the dialect; a
# repo-wide shell key would lint a future #!/bin/sh script as bash.
